# Traefik Configuration
APP_NAME=looty
APP_DOMAIN=looty.ethanfacca.fr
# Version des images Docker (docker-compose.prod.yml) : « latest » par défaut, ou un numéro
# de version publié (ex. 0.10.0) pour rester sur une version précise.
# LOOTY_VERSION=latest

# DB
DB_NAME=looty_db
DB_USER=looty_user
DB_PASSWORD=secret_password

# Zitadel / OIDC (pour la Version 1)
OIDC_ISSUER=https://zitadel.example.com
OIDC_CLIENT_ID=votre_client_id
OIDC_CLIENT_SECRET=votre_client_secret
# Facultatif : UUID fixe du fournisseur, pour connaître l'URL de redirection avant le premier
# démarrage (BASE_URL/api/auth/callback/<UUID>). Vide : UUID aléatoire. Pris en compte une seule
# fois, à la création du fournisseur. Générer avec : uuidgen
# OIDC_PROVIDER_ID=
# Certificats PEM d'une autorité interne à accepter pour le fournisseur (facultatif).
# OIDC_CA_FILE=

# Fournisseur OIDC inclus (Pocket ID) : seulement avec les fichiers *.pocket-id.* (README, « Bundled
# Pocket ID »). Remplacez alors le bloc OIDC ci-dessus par :
#   AUTH_DOMAIN=auth.looty.example.com              # sous-domaine dédié, son DNS pointe vers ce serveur
#   OIDC_ISSUER=https://auth.looty.example.com      # https:// + AUTH_DOMAIN
#   OIDC_CLIENT_ID=looty
#   OIDC_CLIENT_SECRET=                             # openssl rand -hex 32
#   OIDC_PROVIDER_ID=                               # uuidgen (obligatoire ici)
#   POCKET_ID_ENCRYPTION_KEY=                       # openssl rand -base64 32
#   POCKET_ID_STATIC_API_KEY=                       # openssl rand -hex 32

# En développement (local) :
BASE_URL=http://localhost:3000

# Pour la production :
# BASE_URL=https://looty.ethanfacca.fr

# Chiffrement des secrets (mots de passe CalDAV). Générez une valeur aléatoire :
#   openssl rand -base64 32
LOOTY_SECRET_KEY=

# Autoriser les serveurs CalDAV en réseau privé ou en http (false par défaut)
CALDAV_ALLOW_PRIVATE=false

# Autoriser les serveurs Jupyter des notebooks en réseau privé ou en http (false par défaut)
JUPYTER_ALLOW_PRIVATE=false

# Démo publique (jamais sur une vraie instance) : remplace la connexion par « Entrer dans la démo », une copie
# jetable de l'espace « Looty Démo » par visiteur (supprimée après 24 h), et refuse les fonctions qui chargent le
# serveur ou sortent vers l'extérieur. Pour une démo publique, utilisez docker-compose.demo.yml (pile à part).
LOOTY_DEMO=false
# Limites de la démo (valeurs par défaut) : copies simultanées, copies par adresse et par heure (le reverse proxy
# doit envoyer X-Forwarded-For), taille d'un envoi et total par copie en Mo.
# LOOTY_DEMO_MAX_COPIES=30
# LOOTY_DEMO_COPIES_PER_IP_HOUR=5
# LOOTY_DEMO_MAX_FILE_MB=2
# LOOTY_DEMO_MAX_COPY_MB=20

# Emplacement des données PostgreSQL (docker-compose.prod.yml). Par défaut : ./data/postgres, à côté du fichier compose.
# Un chemin absolu (ex. /srv/looty/postgres) les met dans ce dossier de l'hôte.
# Pour y déplacer une base qui est encore dans l'ancien volume « postgres_data_18 » : README, « Move the database ».
# LOOTY_DB_DATA=
