# Réglages de l'instance Looty. Fichier généré par scripts/env-reference.mjs à partir de docs/env-vars.json :
# modifier la source, pas ce fichier. Référence complète : https://looty.untypequicode.fr/fr/docs/reference/environment/

# --- Déploiement ---
# Nom de la pile dans Traefik (noms des routeurs). Un mot court.
APP_NAME=looty
# Nom de domaine de l'instance. Son DNS doit pointer vers la machine.
APP_DOMAIN=looty.example.org
# Version des images Docker : « latest » par défaut, ou un numéro de version publié pour rester sur une version
# précise.
# LOOTY_VERSION=0.33.0
# Adresse publique de l'instance (https://domaine, sans « / » final). Sert aux redirections de connexion, aux
# e-mails et aux liens.
BASE_URL=https://looty.example.org

# --- Base de données ---
# Dossier de l'hôte où PostgreSQL stocke ses données. Un chemin absolu les place ailleurs.
# LOOTY_DB_DATA=/srv/looty/postgres
# Nom de la base PostgreSQL.
DB_NAME=looty_db
# Utilisateur PostgreSQL.
DB_USER=looty_user
# Mot de passe PostgreSQL. À changer.
DB_PASSWORD=secret_password

# --- Connexion (OpenID Connect) ---
# Adresse de votre fournisseur OpenID Connect (issuer). Lue seulement au tout premier démarrage ; ensuite, le
# fournisseur se modifie dans l'administration.
OIDC_ISSUER=https://zitadel.example.com
# Identifiant du client Looty chez le fournisseur.
OIDC_CLIENT_ID=votre_client_id
# Secret du client Looty chez le fournisseur.
OIDC_CLIENT_SECRET=votre_client_secret
# UUID fixe du fournisseur, pour connaître l'URL de redirection (BASE_URL/api/auth/callback/UUID) avant le
# premier démarrage. Pris en compte une seule fois, à la création du fournisseur. Générer avec : uuidgen
# OIDC_PROVIDER_ID=0b8e6c1e-5d3a-4c1f-9a77-2f6a1d4b9e10
# Fichier PEM d'une autorité de certification interne à accepter pour le fournisseur. À monter dans le conteneur
# backend.
# OIDC_CA_FILE=/certs/ca.pem

# --- Sécurité et réseau ---
# Clé qui chiffre les secrets stockés (mots de passe CalDAV, clés d'IA, jetons Jupyter). À garder avec les
# sauvegardes : sans elle, ces secrets sont perdus.
LOOTY_SECRET_KEY=
# Autoriser les serveurs CalDAV en réseau privé ou en http (par exemple un Nextcloud interne).
CALDAV_ALLOW_PRIVATE=false
# Autoriser les serveurs Jupyter des notebooks en réseau privé ou en http.
JUPYTER_ALLOW_PRIVATE=false
# Autoriser les fournisseurs d'IA en réseau privé ou en http (par exemple Ollama sur la même machine). Aussi
# autorisé quand CALDAV_ALLOW_PRIVATE vaut true.
# AI_ALLOW_PRIVATE=true

# --- E-mails ---
# Serveur d'envoi des e-mails. Repli : mieux vaut configurer Administration > E-mail. Sans SMTP_HOST et
# SMTP_FROM, l'envoi est désactivé.
# SMTP_HOST=smtp.example.org
# Adresse de l'expéditeur.
# SMTP_FROM=looty@example.org
# Nom de l'expéditeur.
# SMTP_FROM_NAME=Looty
# Port du serveur d'e-mails.
# SMTP_PORT=587
# Sécurité de la connexion : starttls, tls ou none.
# SMTP_SECURITY=tls
# Utilisateur du serveur d'e-mails.
# SMTP_USERNAME=looty
# Mot de passe du serveur d'e-mails.
# SMTP_PASSWORD=

# --- Intégrations et fonctions ---
# Fuseau horaire par défaut des agendas, des statistiques et des sauvegardes (nom IANA).
# CALENDAR_DEFAULT_TZ=Europe/Paris

# --- Démo publique ---
# Démo publique : remplace la connexion par « Entrer dans la démo », une copie jetable par visiteur. Jamais sur
# une vraie instance ; utilisez docker-compose.demo.yml.
LOOTY_DEMO=false
# Démo : copies simultanées.
# LOOTY_DEMO_MAX_COPIES=30
# Démo : copies par adresse et par heure (le reverse proxy doit envoyer X-Forwarded-For).
# LOOTY_DEMO_COPIES_PER_IP_HOUR=5
# Démo : taille d'un envoi, en Mo.
# LOOTY_DEMO_MAX_FILE_MB=2
# Démo : taille totale par copie, en Mo.
# LOOTY_DEMO_MAX_COPY_MB=20

# Avec le fournisseur inclus (Pocket ID, fichiers *.pocket-id.*), remplacez le bloc OIDC par :
#   AUTH_DOMAIN=auth.looty.example.org          # sous-domaine dédié, son DNS pointe vers ce serveur
#   OIDC_ISSUER=https://auth.looty.example.org  # https:// + AUTH_DOMAIN
#   OIDC_CLIENT_ID=looty
#   OIDC_CLIENT_SECRET=                          # openssl rand -hex 32
#   OIDC_PROVIDER_ID=                            # uuidgen (obligatoire ici)
#   POCKET_ID_ENCRYPTION_KEY=                    # openssl rand -base64 32
#   POCKET_ID_STATIC_API_KEY=                    # openssl rand -hex 32
