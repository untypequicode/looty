# docker-compose.demo.yml : instance de démonstration (à côté de votre vraie instance, dans son propre dossier).
DEMO_DOMAIN=demo.looty.untypequicode.fr
# Version des images (« latest » par défaut ; la 0.30.0 est la première avec le mode démo).
# LOOTY_VERSION=0.30.0
# Obligatoire, à générer : openssl rand -hex 16
DB_PASSWORD=

# Limites par défaut ; ajustez selon la taille du serveur.
# LOOTY_DEMO_MAX_COPIES=30
# LOOTY_DEMO_COPIES_PER_IP_HOUR=5
# LOOTY_DEMO_MAX_FILE_MB=2
# LOOTY_DEMO_MAX_COPY_MB=20
