{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Looty",
  "mainBinaryName": "looty",
  "version": "0.8.0",
  "identifier": "app.looty.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "Productivity",
    "shortDescription": "Looty — tasks and wiki",
    "longDescription": "Desktop client for a Looty server: boards, tasks and collaborative wiki, with tray icon, notifications and offline mode.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "glib-networking"
        ],
        "recommends": [
          "hunspell-fr",
          "hunspell-en-us"
        ],
        "section": "utils",
        "desktopTemplate": "../looty.desktop"
      }
    },
    "publisher": "Looty",
    "copyright": "Looty contributors",
    "homepage": "https://github.com/untypequicode/looty"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBNDRGOTMxRDBGQUM3QzAKUldUQXgvclFNZmxFS2owUEZUVTZ2UHZ4Zzl2dnphcFhYTjUzaStyM0hBYkJ2b3hXZTBYdVYxOVAK",
      "endpoints": [
        "https://github.com/untypequicode/looty/releases/download/updater/latest.json"
      ]
    }
  }
}
