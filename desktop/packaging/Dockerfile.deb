# Construction du paquet .deb dans Debian 12 (bookworm) : le binaire est lié aux
# bibliothèques de Debian (WebKitGTK 4.1, GTK 3, libayatana-appindicator).
FROM rust:1-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
      libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev libssl-dev \
      pkg-config file xdg-utils \
    && rm -rf /var/lib/apt/lists/*
RUN cargo install tauri-cli --version "^2" --locked
WORKDIR /src/desktop/src-tauri
ENV CARGO_TARGET_DIR=/target
CMD ["cargo", "tauri", "build", "--bundles", "deb"]
