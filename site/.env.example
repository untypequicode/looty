# À copier en .env à côté de docker-compose.prod.yml (sur le serveur du site).
SITE_DOMAIN=looty.untypequicode.fr
# Jeton secret des dépôts de fichiers : openssl rand -hex 32
# Le MÊME jeton va dans le secret GitHub SITE_UPLOAD_TOKEN.
SITE_UPLOAD_TOKEN=
# Nom des routeurs Traefik (à changer seulement s'il existe déjà un routeur de ce nom).
SITE_NAME=looty-site
# Version de l'image (latest par défaut).
#LOOTY_SITE_VERSION=latest
