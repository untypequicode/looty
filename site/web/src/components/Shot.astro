---
// Capture de l'application (clair ou sombre selon le thème de la page), dans une fenêtre de navigateur.
// `crop` : hauteur affichée en proportion de la largeur (le haut de la capture est gardé), pour couper le vide.
interface Props { name: string; lang: string; alt: string; url?: string; eager?: boolean; crop?: number }
const { name, lang, alt, url = 'looty.example.org', eager = false, crop } = Astro.props
const src = (theme: string) => `/shots/${name}-${theme}-${lang}.webp`
const load = eager ? 'eager' : 'lazy'
const style = crop ? `aspect-ratio: 1 / ${crop}` : undefined
---
<div class="frame">
  <div class="bar"><i></i><i></i><i></i><span>{url}</span></div>
  <div class={crop ? 'view crop' : 'view'} style={style}>
    <img class="only-dark" src={src('dark')} alt={alt} width="1800" height="1108" loading={load} decoding="async" fetchpriority={eager ? 'high' : 'auto'} />
    <img class="only-light" src={src('light')} alt={alt} width="1800" height="1108" loading={load} decoding="async" />
  </div>
</div>
