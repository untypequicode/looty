---
import Base from '../layouts/Base.astro'
import Icon from './Icon.astro'
import Shot from './Shot.astro'
import Clip from './Clip.astro'
import Phone from './Phone.astro'
import { t, REPO, DEMO, type Lang } from '../i18n'
interface Props { lang: Lang }
const { lang } = Astro.props
const l = t[lang]
const phones = ['home', 'tasks', 'doc', 'board']
const platforms = [['android', 'phone'], ['linux', 'monitor'], ['windows', 'monitor']] as const
const strings = JSON.stringify({ version: l.dl.version, released: l.dl.released, checksum: l.dl.checksum, missing: l.dl.missing, recommended: l.recommended, lang, repo: REPO })
// Hauteur affichée des captures (part de la largeur) : le vide sous le contenu est coupé.
const crops: Record<string, number> = { board: 0.4, calendar: 0.5 }
---
<Base lang={lang} home>
  <main id="main">
    <section class="hero" style="padding-bottom:0">
      <div class="wrap">
        <span class="eyebrow reveal"><b>{l.hero.eyebrow}</b> · {l.hero.eyebrow2}</span>
        <h1 class="reveal">{l.hero.pre} <em>{l.hero.em}</em>{l.hero.post}</h1>
        <p class="lead reveal">{l.hero.lead}</p>
        <div class="cta reveal">
          <a class="btn primary" href={DEMO}><Icon name="play" size={17} />{l.hero.cta}</a>
          <a class="btn" href={`${l.homeHref}install/`}><Icon name="server" size={17} />{l.hero.cta2}</a>
        </div>
        <p class="chips">{l.hero.chips.map((c) => <span><Icon name="check" size={15} />{c}</span>)}</p>
        <div class="hero-shot">
          <Shot name="home" lang={lang} alt={l.hero.shot} url="looty.example.org/w/acme" eager />
          <div class="hero-phone"><Phone name="home" lang={lang} alt={l.hero.phone} /></div>
        </div>
      </div>
    </section>

    <section id="start" class="start" aria-labelledby="start-h">
      <div class="wrap center">
        <h2 id="start-h">{l.start.h}</h2>
        <p class="sub">{l.start.p}</p>
        <div class="paths">
          {l.start.cards.map(([icon, name, text, cta, href, more, moreHref]) => (
            <div class="card">
              <span class="ico"><Icon name={icon} /></span>
              <h3>{name}</h3>
              <p>{text}</p>
              <p class="acts"><a class="btn primary" href={href.startsWith('http') || href.startsWith('#') ? href : `/${href}`}>{cta}</a><a class="btn" href={`/${moreHref}`}>{more}</a></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="features">
      <div class="wrap">
        {l.show.map((s) => (
          <div class={s.flip ? 'row flip' : 'row'}>
            <div class="copy">
              <p class="kicker">{s.kicker}</p>
              <h2>{s.h}</h2>
              <p>{s.p}</p>
              <ul class="ticks">{s.ticks.map((x) => <li>{x}</li>)}</ul>
            </div>
            <div class="media">
              <Shot name={s.shot} lang={lang} alt={s.alt} url={s.url} crop={crops[s.shot]} />
            </div>
          </div>
        ))}
        <div class="center" style="margin-top:80px">
          <p class="kicker">{l.motion.kicker}</p>
          <h2>{l.motion.h}</h2>
        </div>
        <div class="motion">
          {l.motion.items.map(([name, caption]) => <Clip name={name} lang={lang} caption={caption} />)}
        </div>
        <div class="center" style="margin-top:80px">
          <p class="kicker">{l.more.kicker}</p>
          <h2>{l.more.h}</h2>
        </div>
        <div class="grid">
          {l.features.map(([icon, name, text]) => <div class="card"><span class="ico"><Icon name={icon} /></span><h3>{name}</h3><p>{text}</p></div>)}
        </div>
      </div>
    </section>

    <section id="apps" class="apps">
      <div class="wrap center">
        <p class="kicker">{l.apps.kicker}</p>
        <h2>{l.apps.h}</h2>
        <p class="sub">{l.apps.p}</p>
        <div class="phones">{phones.map((p, i) => <Phone name={p} lang={lang} alt={l.apps.caps[i]} caption={l.apps.caps[i]} />)}</div>
        <div class="platforms" style="text-align:left">
          {l.apps.cards.map(([icon, name, text]) => <div class="card"><span class="ico"><Icon name={icon} /></span><h3>{name}</h3><p>{text}</p></div>)}
        </div>
      </div>
    </section>

    <section id="host">
      <div class="wrap host">
        <div>
          <p class="kicker">{l.host.kicker}</p>
          <h2>{l.host.h}</h2>
          <p class="sub" style="margin-bottom:18px">{l.host.p}</p>
          <ul class="ticks">{l.host.ticks.map((x) => <li>{x}</li>)}</ul>
          <p class="free">{l.host.free} <a href={REPO}>{l.host.repo}</a> · <a href={`${REPO}/blob/main/LICENSE`}>{l.host.licence}</a></p>
          <p class="acts"><a class="btn primary" href={`${l.homeHref}install/`}>{l.host.gen}</a><a class="btn" href={`${l.homeHref}docs/host/`}>{l.host.docs}</a></p>
        </div>
        <div>
          <h3>{l.host.cmd}</h3>
          <pre data-copy id="cmd"><code>curl -fsSL SITE/install.sh | sh -s -- --domain looty.example.org --proxy caddy --auth bundled-oidc</code></pre>
          <p class="note">{l.host.cmdNote}</p>
        </div>
      </div>
    </section>

    <section id="download">
      <div class="wrap">
        <div class="center">
          <p class="kicker">{l.dl.kicker}</p>
          <h2>{l.dl.h}</h2>
          <p class="sub">{l.dl.p}</p>
        </div>
        <div class="dl" id="dl" data-strings={strings}>
          {platforms.map(([p, icon]) => (
            <div class="card" data-platform={p}>
              <span class="ico"><Icon name={icon} /></span>
              <div><h3>{l.dl[p][0]} <span class="badge" data-rec hidden>{l.recommended}</span></h3><p>{l.dl[p][1]}</p><div class="meta" data-meta>{l.dl.loading}</div></div>
              <div class="acts">
                <a class="btn primary" data-get href={`/download/${p}`} hidden><Icon name="download" size={16} />{l.dl.get}</a>
                <a class="btn" data-gh href={`${REPO}/releases?q=${p}`} hidden><Icon name="github" size={16} />{l.dl.github}</a>
              </div>
            </div>
          ))}
        </div>
        <h3 class="more-h">{l.dl.moreH}</h3>
        <div class="more">
          {l.dl.more.map(([os, icon, name, text, href]) => (
            <div class="card" data-os={os}>
              <span class="ico"><Icon name={icon} /></span>
              <div><h3>{name} <span class="badge" data-rec hidden>{l.recommended}</span></h3><p>{text}</p><p class="acts"><a class="btn sm" href={`/${href}`}>{l.dl.guide}</a></p></div>
            </div>
          ))}
        </div>
        <div class="two">
          <div class="card"><h3>{l.dl.aptH}</h3><p style="margin-bottom:12px">{l.dl.aptP}</p>
<pre id="apt" data-copy><code>sudo curl -fsSL SITE/apt/looty-archive-keyring.gpg -o /usr/share/keyrings/looty-archive-keyring.gpg
sudo tee /etc/apt/sources.list.d/looty.sources &gt;/dev/null &lt;&lt;'EOF2'
Types: deb
URIs: SITE/apt
Suites: stable
Components: main
Architectures: amd64
Signed-By: /usr/share/keyrings/looty-archive-keyring.gpg
EOF2
sudo apt update &amp;&amp; sudo apt install looty</code></pre></div>
          <div class="card"><h3>{l.dl.nixH}</h3><p style="margin-bottom:12px">{l.dl.nixP}</p>
<pre data-copy><code>nix run github:untypequicode/looty#looty-desktop
nix profile install github:untypequicode/looty#looty-desktop</code></pre></div>
        </div>
      </div>
    </section>
  </main>
  <script is:inline>
    // Dernières versions lues dans /latest.json ; une plateforme absente mène à GitHub.
    (function () {
      var box = document.getElementById('dl'); if (!box) return;
      var s = JSON.parse(box.dataset.strings);
      var apt = document.getElementById('apt'); if (apt) apt.innerHTML = apt.innerHTML.replace(/SITE/g, location.origin);
      var cmd = document.getElementById('cmd'); if (cmd) cmd.innerHTML = cmd.innerHTML.replace(/SITE/g, location.origin);
      function mb(n) { return (n / 1048576).toFixed(1) + ' MB'; }
      function fill(d) {
        box.querySelectorAll('[data-platform]').forEach(function (card) {
          var p = d[card.dataset.platform]; var meta = card.querySelector('[data-meta]');
          var get = card.querySelector('[data-get]'); var gh = card.querySelector('[data-gh]');
          if (!p) { meta.textContent = s.missing; gh.hidden = false; return; }
          get.hidden = false; get.href = p.url;
          var date = p.date ? new Date(p.date).toLocaleDateString(s.lang) : '';
          meta.textContent = s.version + ' ' + p.version + (date ? ' · ' + s.released + ' ' + date : '') + (p.size ? ' · ' + mb(p.size) : '');
          if (p.sha256) { var c = document.createElement('code'); c.textContent = s.checksum + ': ' + p.sha256; meta.appendChild(c); }
        });
      }
      // Plateforme du visiteur : sa carte passe en premier, avec un badge.
      var ua = navigator.userAgent, mine = /iPhone|iPad|iPod/i.test(ua) ? 'ios' : /Android/i.test(ua) ? 'android' : /Windows/i.test(ua) ? 'windows' : /Linux|X11/i.test(ua) && !/CrOS/i.test(ua) ? 'linux' : null;
      var card = mine && box.querySelector('[data-platform="' + mine + '"]');
      if (card) { card.classList.add('rec'); card.querySelector('[data-rec]').hidden = false; box.prepend(card); }
      // Autres façons d'installer : celles de la plateforme du visiteur sont mises en avant.
      document.querySelectorAll('[data-os]').forEach(function (c) {
        var os = c.dataset.os;
        if (os === mine || (mine === 'android' && os === 'fdroid') || (mine === 'linux' && os === 'flatpak') || (mine === 'windows' && os === 'winget')) { c.classList.add('rec'); c.querySelector('[data-rec]').hidden = false; c.parentNode.prepend(c); }
      });
      fetch('/latest.json', { cache: 'no-cache' }).then(function (r) { return r.json(); }).then(fill).catch(function () { fill({}); });
    })();
  </script>
</Base>

<style>
  .motion { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 22px; margin-top: 36px; }
</style>
