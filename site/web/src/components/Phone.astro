---
// Capture de l'application Android native, dans un téléphone.
interface Props { name: string; lang: string; alt: string; caption?: string; eager?: boolean }
const { name, lang, alt, caption, eager = false } = Astro.props
const src = (theme: string) => `/shots/phone-${name}-${theme}-${lang}.webp`
const load = eager ? 'eager' : 'lazy'
---
<figure class="phone" style="margin:0">
  <div class="screen">
    <img class="only-dark" src={src('dark')} alt={alt} width="540" height="1200" loading={load} decoding="async" />
    <img class="only-light" src={src('light')} alt={alt} width="540" height="1200" loading={load} decoding="async" />
  </div>
  {caption && <figcaption class="cap">{caption}</figcaption>}
</figure>
