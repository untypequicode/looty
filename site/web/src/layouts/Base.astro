---
import '@fontsource-variable/inter'
import '../styles/global.css'
import Icon from '../components/Icon.astro'
import { t, REPO, type Lang } from '../i18n'
interface Props { lang: Lang; title?: string; description?: string }
const { lang, title, description } = Astro.props
const l = t[lang]
const base = l.homeHref
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? l.title}</title>
    <meta name="description" content={description ?? l.description} />
    <meta property="og:title" content={title ?? l.title} />
    <meta property="og:description" content={description ?? l.description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`/shots/board-dark-${lang}.webp`} />
    <meta name="theme-color" content="#0b0b0d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href="/" />
    <link rel="alternate" hreflang="fr" href="/fr/" />
    <script is:inline>
      // Thème : celui choisi ici, sinon celui du système (sombre par défaut, comme l'application). Avant l'affichage : pas de flash.
      try { var s = localStorage.getItem('looty-site-theme'); document.documentElement.dataset.theme = s || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'); } catch (e) {}
    </script>
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <a class="brand" href={base}><img src="/favicon.svg" alt="" width="28" height="28" />Looty</a>
        <nav class="nav">
          <a class="link" href={`${base}#features`}>{l.nav.features}</a>
          <a class="link" href={`${base}#apps`}>{l.nav.apps}</a>
          <a class="link" href={`${base}#host`}>{l.nav.host}</a>
        </nav>
        <div class="tools">
          <a class="icon-btn lang" href={l.other.href} hreflang={l.other.code} aria-label={l.other.code}>{l.other.label}</a>
          <button class="icon-btn" id="theme" type="button" aria-label={l.theme}>
            <span class="only-dark"><Icon name="sun" size={17} /></span><span class="only-light"><Icon name="moon" size={17} /></span>
          </button>
          <a class="icon-btn" href={REPO} aria-label="GitHub"><Icon name="github" size={17} /></a>
          <a class="btn primary sm" href={`${base}#download`}>{l.nav.download}</a>
        </div>
      </div>
    </header>
    <slot />
    <footer>
      <div class="wrap">
        <div><a class="brand" href={base}><img src="/favicon.svg" alt="" width="24" height="24" />Looty</a><p style="margin:12px 0 0;max-width:300px">{l.footer.tag}</p></div>
        <div class="cols">
          <div><h4>{l.footer.product}</h4><a href={`${base}#features`}>{l.nav.features}</a><a href={`${base}#apps`}>{l.nav.apps}</a><a href={`${base}#download`}>{l.nav.download}</a></div>
          <div><h4>{l.footer.project}</h4><a href={REPO}>{l.footer.source}</a><a href={`${REPO}/releases`}>{l.footer.releases}</a><a href={`${REPO}/issues`}>{l.footer.issues}</a><a href={`${REPO}/blob/main/LICENSE`}>{l.footer.license}</a></div>
        </div>
      </div>
    </footer>
    <script is:inline>
      document.getElementById('theme').addEventListener('click', function () {
        var next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('looty-site-theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>
